{
  "name": "rogueengine-mcp-full",
  "version": "1.1.0",
  "description": "MCP server for RogueEngine game development",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rogueengine-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "extract": "tsc -p tsconfig.tools.json && node .tools-build/tools/extract-engine-api.js",
    "verify": "npm run build && node scripts/verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.5.3"
  },
  "private": true
}
